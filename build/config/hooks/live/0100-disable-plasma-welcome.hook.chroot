#!/bin/sh
set -e

# Plasma Welcome Center is a KDE first-run wizard. It is not part of the
# Aether identity, and it covers the desktop during automated tests.
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/org.kde.plasma-welcome.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Welcome Center
Exec=plasma-welcome
Hidden=true
EOF

if [ -f /usr/lib/systemd/user/plasma-welcome.service ]; then
  mkdir -p /etc/systemd/user
  ln -sfn /dev/null /etc/systemd/user/plasma-welcome.service
fi
